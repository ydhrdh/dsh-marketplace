  "tags": ["multi-agent", "multi-model", "orchestration", "workflow", "dag", "web", "token-usage"],
  "compatibility": {
    "dsh": ">=0.1.0-rc.5 <0.2.0",
    "platforms": ["linux", "macos", "windows"]
  },
  "install": {
    "target": "git",
    "spec": "github:toolclub/dsh-agent-team-gui#v0.5.0",
    "command": "dsh plugin --profile {profile} add -w github:toolclub/dsh-agent-team-gui#v0.5.0"
