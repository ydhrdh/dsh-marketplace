{
  "id": "dsh-priceflow",
  "name": "PriceFlow",
  "version": "0.2.0",
  "description": "Shows DeepSeek PEAK/OFF-PEAK pricing and countdowns in the composer, with official USD/CNY pricing, optional account balance, and durable off-peak text-message scheduling.",
  "descriptionZh": "在输入框下方显示 DeepSeek 峰价/低谷时段、倒计时和官方美元/人民币价格，并支持可选余额显示与低谷文本消息持久调度。",
  "author": {
    "name": "williamzhangww",
    "url": "https://github.com/williamzhangww"
  },
  "license": "MIT",
  "category": "tools",
  "tags": [
    "pricing",
    "off-peak",
    "scheduling",
    "queue",
    "balance",
    "composer"
  ],
  "compatibility": {
    "dsh": "0.2.0-rc.1"
  },
  "install": {
    "target": "npm",
    "spec": "dsh-priceflow",
    "command": "dsh plugin --profile {profile} add dsh-priceflow"
  },
  "verified": false,
  "maintainers": [
    "williamzhangww"
  ],
  "repository": "https://github.com/williamzhangww/dsh-priceflow",
  "docs": "https://github.com/williamzhangww/dsh-priceflow"
}