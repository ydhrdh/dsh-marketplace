    "models",
    "relay",
    "accounts"
  ],
  "compatibility": {
    "dsh": "0.2.0-rc.2",
    "platforms": [
      "linux",
      "macos",
      "windows"
    ]
  },
  "install": {
    "target": "git",
    "spec": "github:FuSheng-cs/Trae2api-dsh#v1.3.1",
    "command": "dsh plugin --profile {profile} add github:FuSheng-cs/Trae2api-dsh#v1.3.1"
  },
  "verified": false,
  "maintainers": [
    "FuSheng-cs"
  ],
  "repository": "https://github.com/FuSheng-cs/Trae2api-dsh",
  "docs": "https://github.com/FuSheng-cs/Trae2api-dsh#readme",
  "screenshots": [
    "https://github.com/FuSheng-cs/Trae2api-dsh/raw/v1.3.1/assets/embedded-console.png",
    "https://github.com/FuSheng-cs/Trae2api-dsh/raw/v1.3.1/assets/model-catalog.png"
  ]
